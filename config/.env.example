# ─────────────────────────────────────────────
# Sugi v0.1L — Environment Configuration
# ─────────────────────────────────────────────

# ── API Keys ──────────────────────────────────
PERENUAL_API_KEY=""

# ── Database ──────────────────────────────────
PORT=3000
MONGO_URI=""

# ── ChromaDB ──────────────────────────────────
CHROMA_HOST=
CHROMA_PORT=

# ── Ollama Models ─────────────────────────────
EMBED_MODEL=mxbai-embed-large
LLM_MODEL=sugi-v0.1L
UTILITY_MODEL=qwen2.5:1.5b

# ── Telegram Bot ──────────────────────────────
TELEGRAM_BOT_TOKEN=""
# R1 (fail-closed): KOSONGKAN = SEMUA perintah debug (/debug, !debug/!flags/!session/!memory/!stats)
# dinonaktifkan untuk semua user (aman by default, warning muncul saat startup).
# Isi user_id (pisahkan koma) untuk melonggarkan: DEBUG_ALLOWED_USERS=123456,789012
DEBUG_ALLOWED_USERS=

# ── Word Config paths ─────────────────────────
SCOPE_CONFIG_PATH=config/settings/scope_config.ini
REWRITER_CONFIG_PATH=config/settings/rewriter_config.ini
PLANT_CONFIG_PATH=config/settings/plant_keywords.ini

# ── App Config ────────────────────────────────
MEMORY_TTL_DAYS=14
BM25_CACHE_PATH=data/db/bm25_cache.pkl

# ── Ollama Concurrency / Startup Stagger ──────
# Tiap insight service menahan run pertama beberapa detik setelah start,
# biar chatbot (RAG) memenangkan warm-up Ollama dan service tidak saling
# berebut. Masing-masing punya var grace sendiri; nilai fallback = var
# bersama STARTUP_GRACE_SECONDS; bila keduanya kosong, default stagger:
# Daily=180s, Government=240s, Farmer=300s (A8).
DAILY_INSIGHT_GRACE_SECONDS=180
GOVERNMENT_INSIGHT_GRACE_SECONDS=240
FARMER_INSIGHT_GRACE_SECONDS=300
STARTUP_GRACE_SECONDS=180
# INSIGHT_LLM_DELAY: jeda detik antar pemanggilan LLM di dalam loop
# insight service (hindari banjir request ke Ollama lokal). 0 = matikan.
INSIGHT_LLM_DELAY=1
# DAILY_INSIGHT_MAX_WORKERS: jumlah worker LLM harian (A12).
# 1 = berurutan + jeda INSIGHT_LLM_DELAY (default, aman untuk Ollama).
# >1 = buka thread pool dengan n worker (keputusan deliberate, bukan default).
DAILY_INSIGHT_MAX_WORKERS=1